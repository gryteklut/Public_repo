---
import { curriculum } from "@/data/curriculum";
import { withBase } from "@/lib/base";

export function getStaticPaths() {
  return curriculum.flatMap((day) =>
    day.modules.map((mod) => ({
      params: { dayId: day.id, moduleId: mod.id },
      props: { dayNumber: day.dayNumber },
    })),
  );
}

const { dayNumber } = Astro.props;
return Astro.redirect(withBase(`/courses/ab-650/day-${dayNumber}/`), 301);
---
