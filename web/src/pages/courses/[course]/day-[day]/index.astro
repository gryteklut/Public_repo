---
import {
  courseSlugFromId,
  getCourse,
  getCourses,
  sessionPath,
} from "@/lib/courses";
import { LEGACY_DAY_TO_SESSION } from "@/lib/sessionSchedule";
import { withBase } from "@/lib/base";

export async function getStaticPaths() {
  const courses = await getCourses();
  const paths = [];
  for (const course of courses) {
    const slug = courseSlugFromId(course.id);
    const map = LEGACY_DAY_TO_SESSION[course.data.code] ?? {};
    for (const day of Object.keys(map)) {
      paths.push({ params: { course: slug, day } });
    }
  }
  return paths;
}

const slug = Astro.params.course!;
const day = Astro.params.day!;
const course = await getCourse(slug);
const session = course
  ? LEGACY_DAY_TO_SESSION[course.data.code]?.[day]
  : undefined;
return Astro.redirect(
  withBase(session ? sessionPath(slug, Number(session)) : `/courses/${slug}/`),
  301,
);
---
