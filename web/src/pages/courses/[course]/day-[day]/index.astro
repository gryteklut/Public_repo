---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { CompletionBar } from "@/components/courses/CompletionBar";
import { LabChecklist } from "@/components/courses/LabChecklist";
import { LessonPlan } from "@/components/courses/LessonPlan";
import { WatchChecklist } from "@/components/courses/WatchChecklist";
import { render } from "astro:content";
import {
  courseSlugFromId,
  getCourse,
  getCourseDay,
  getCourseDays,
  getCourses,
} from "@/lib/courses";
import { withBase } from "@/lib/base";
import "starlight-quiz/styles";

export async function getStaticPaths() {
  const courses = await getCourses();
  const paths = [];
  for (const c of courses) {
    const slug = courseSlugFromId(c.id);
    const days = await getCourseDays(slug);
    for (const d of days) {
      paths.push({
        params: { course: slug, day: String(d.data.day) },
      });
    }
  }
  return paths;
}

const slug = Astro.params.course!;
const dayNum = Number(Astro.params.day);
const course = await getCourse(slug);
const dayEntry = await getCourseDay(slug, dayNum);
const allDays = await getCourseDays(slug);

if (!course || !dayEntry) {
  return Astro.redirect(withBase("/courses/"));
}

const { Content } = await render(dayEntry);
const d = dayEntry.data;
const code = course.data.code;
const watchLabels = d.videos
  .filter((v) => v.action === "watch")
  .map((v) => v.label);
---

<DefaultLayout title={`${d.moduleTitle} · ${code}`} description={d.summary}>
  <div class="course-shell container pt-28 pb-16 lg:pt-40">
    <div class="space-y-6">
      <nav class="text-muted-foreground flex flex-wrap items-center gap-2 text-sm">
        <a class="hover:text-foreground" href={withBase("/courses/")}>Courses</a>
        <span>/</span>
        <a class="hover:text-foreground" href={withBase(`/courses/${slug}/`)}
          >{code}</a
        >
        <span>/</span>
        <span class="text-foreground">Day {d.day}</span>
      </nav>

      <header class="course-card p-5 shadow-xs md:p-6">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p
              class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
            >
              Day {d.day}{d.practice ? " · Practice mode" : " · Learning mode"}
            </p>
            <h1 class="mt-1 text-3xl font-semibold tracking-tight">
              {d.moduleTitle}
            </h1>
            <p
              class="text-muted-foreground mt-2 max-w-3xl text-sm leading-relaxed md:text-base"
            >
              {d.summary}
            </p>
          </div>
          <span class="bg-muted rounded-full px-3 py-1 text-xs font-medium"
            >~{d.minutes} min</span
          >
        </div>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {
            d.tags.map((tag) => (
              <span class="bg-secondary text-secondary-foreground rounded-full px-2.5 py-0.5 text-xs font-medium">
                {tag}
              </span>
            ))
          }
        </div>
      </header>

      <div
        class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] xl:grid-cols-[minmax(0,1fr)_360px]"
      >
        <div class="min-w-0 space-y-6">
          <section class="course-card p-5 md:p-6">
            <h2 class="text-lg font-semibold">Overview · 4-step plan</h2>
            <ol class="mt-3 grid gap-2 sm:grid-cols-2">
              {
                [
                  "Read resources / Learn links",
                  "Do the watch checklist",
                  "Review TL;DR + exam trap",
                  "Prove with knowledge check",
                ].map((step, i) => (
                  <li class="bg-muted/50 rounded-xl border px-3 py-2 text-sm leading-relaxed">
                    <span class="text-muted-foreground mr-2 text-xs font-semibold">
                      {i + 1}.
                    </span>
                    {step}
                  </li>
                ))
              }
            </ol>
            <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
              {d.focus}
            </p>
          </section>

          {
            d.videos.length > 0 && (
              <WatchChecklist
                client:only="react"
                code={code}
                day={d.day}
                tip={d.videoTip}
                sections={d.videos}
              />
            )
          }

          <section class="course-card p-5 shadow-xs md:p-6">
            <h2 class="text-xl font-semibold">Study resources</h2>
            <ul class="mt-3 space-y-2">
              {
                d.resources.map((link) => (
                  <li>
                    <a
                      class="text-sm font-medium underline-offset-4 hover:underline"
                      href={link.url}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            {
              d.lab.length > 0 && (
                <>
                  <h3 class="mt-6 font-semibold">Optional E5 lab</h3>
                  <div class="mt-2">
                    <LabChecklist
                      client:only="react"
                      code={code}
                      day={d.day}
                      steps={d.lab}
                    />
                  </div>
                </>
              )
            }
            {
              d.outOfScopeNote && (
                <p class="bg-muted text-muted-foreground mt-4 rounded-xl p-3 text-sm leading-relaxed">
                  <strong class="text-foreground">Out of scope note:</strong>{" "}
                  {d.outOfScopeNote}
                </p>
              )
            }
          </section>

          <section class="course-card p-5 md:p-6">
            <h2 class="text-xl font-semibold">TL;DR</h2>
            <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed">
              {d.tldr.map((p) => <li>{p}</li>)}
            </ol>
            <div
              class="border-border mt-4 rounded-xl border border-dashed bg-[color:var(--course-surface)] p-3 text-sm leading-relaxed"
            >
              <strong>Exam trap:</strong> {d.trap}
            </div>
          </section>

          <section class="course-card overflow-hidden shadow-xs">
            <div class="border-b px-4 py-3 md:px-5">
              <span
                class="course-pill inline-flex rounded-full px-3 py-1.5 text-sm font-semibold"
              >
                Knowledge check
              </span>
            </div>
            <div class="prose-course space-y-4 p-4 md:p-6">
              <Content />
              <CompletionBar client:only="react" code={code} day={d.day} />
            </div>
          </section>

          <div class="flex flex-wrap justify-between gap-3 pb-8">
            {
              d.day > 1 ? (
                <a
                  class="border-border bg-card hover:bg-muted inline-flex items-center rounded-lg border px-4 py-2 text-sm font-medium"
                  href={withBase(`/courses/${slug}/day-${d.day - 1}/`)}
                >
                  Previous day
                </a>
              ) : (
                <span />
              )
            }
            {
              d.day < allDays.length && (
                <a
                  class="course-pill inline-flex items-center rounded-lg px-4 py-2 text-sm font-semibold"
                  href={withBase(`/courses/${slug}/day-${d.day + 1}/`)}
                >
                  Next day
                </a>
              )
            }
          </div>
        </div>

        <LessonPlan
          focus={d.focus}
          videoLabels={watchLabels}
          resources={d.resources}
        />
      </div>
    </div>
  </div>
</DefaultLayout>
