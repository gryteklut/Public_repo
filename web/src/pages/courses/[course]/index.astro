---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { CurriculumAccordion } from "@/components/courses/CurriculumAccordion";
import { ProgressCard } from "@/components/courses/ProgressCard";
import {
  courseSlugFromId,
  getCourse,
  getCourseDays,
  getCourses,
  weeksIn,
} from "@/lib/courses";
import { getLabCatalog } from "@/data/officialLabs";
import { withBase } from "@/lib/base";

export async function getStaticPaths() {
  const courses = await getCourses();
  return courses.map((c) => ({
    params: { course: courseSlugFromId(c.id) },
  }));
}

const slug = Astro.params.course!;
const course = await getCourse(slug);
if (!course) {
  return Astro.redirect(withBase("/courses/"));
}
const days = await getCourseDays(slug);
const { data } = course;
const labs = data.hasLabs ? getLabCatalog(data.code) : undefined;
---

<DefaultLayout title={data.title} description={data.subtitle}>
  <div class="course-shell container pt-28 pb-20 lg:pt-40">
    <nav class="text-muted-foreground mb-6 flex flex-wrap gap-2 text-sm">
      <a class="hover:text-foreground" href={withBase("/courses/")}>Courses</a>
      <span>/</span>
      <span class="text-foreground">{data.code}</span>
    </nav>

    <header class="course-card mb-8 p-6 md:p-8">
      <p
        class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
      >
        {data.code} · {data.level}
        {data.status !== "live" ? ` · ${data.status}` : ""}
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        {data.title}
      </h1>
      <p
        class="text-muted-foreground mt-3 max-w-3xl text-base leading-relaxed"
      >
        {data.subtitle}
      </p>
      {
        (data.hasLabs || data.studyGuide) && (
          <p class="mt-4 flex flex-wrap gap-2">
            {data.hasLabs && (
              <a
                class="course-pill inline-flex items-center rounded-lg px-3 py-1.5 text-sm font-semibold"
                href={withBase(`/courses/${slug}/labs/`)}
              >
                Hands-on labs{labs ? ` (${labs.totalMinutes} min)` : ""}
              </a>
            )}
            {data.studyGuide && (
              <a
                class="inline-flex items-center rounded-lg border border-[var(--course-line)] bg-[var(--card)] px-3 py-1.5 text-sm font-semibold"
                href={data.studyGuide}
                target="_blank"
                rel="noreferrer"
              >
                Exam study guide
              </a>
            )}
          </p>
        )
      }
    </header>

    {
      data.external && (
        <section class="course-card mb-8 p-6">
          <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">
            External course · {data.external.provider}
          </p>
          <h2 class="mt-2 text-xl font-semibold">
            <a
              class="hover:text-[var(--ms-accent)]"
              href={data.external.url}
              target="_blank"
              rel="noreferrer"
            >
              {data.external.title}
            </a>
          </h2>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Instructor:{" "}
            <a
              class="text-foreground font-medium underline-offset-4 hover:underline"
              href={data.external.instructorUrl}
              target="_blank"
              rel="noreferrer"
            >
              {data.external.instructor}
            </a>
            . Each session has a one-hour budget. Lecture titles that are not on the exam sit in Optional / deeper dive.
            Microsoft Learn and the official labs stay the primary material.
          </p>
          {data.external.note && (
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
              {data.external.note}
            </p>
          )}
        </section>
      )
    }

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px]">
      <div class="space-y-8">
        {
          data.learn.length > 0 && (
            <section class="course-card p-6">
              <h2 class="text-xl font-semibold">What you'll learn</h2>
              <ul class="text-muted-foreground mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed">
                {data.learn.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {data.outOfScope && (
                <p class="bg-muted text-muted-foreground mt-4 rounded-xl p-3 text-sm leading-relaxed">
                  <strong class="text-foreground">Out of scope:</strong>{" "}
                  {data.outOfScope}
                </p>
              )}
            </section>
          )
        }

        <section>
          <h2 class="mb-3 text-xl font-semibold">
            {weeksIn(days)} weeks · 1 hour each weekday
          </h2>
          <CurriculumAccordion
            client:only="react"
            code={data.code}
            courseSlug={slug}
            sessions={days.map((d) => ({
              session: d.data.session,
              week: d.data.week,
              title: d.data.title,
              minutes: d.data.minutes,
              kind: d.data.kind,
            }))}
          />
          {
            Array.from(new Set(days.map((d) => d.data.week))).map((week) => {
              const notes = days
                .filter((d) => d.data.week === week)
                .flatMap((d) => d.data.optional);
              if (notes.length === 0) return null;
              return (
                <section class="course-card mt-4 p-5">
                  <h3 class="text-sm font-semibold">
                    Week {week} · Optional / deeper dive
                  </h3>
                  <ul class="text-muted-foreground mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed">
                    {notes.map((note) => (
                      <li>{note}</li>
                    ))}
                  </ul>
                </section>
              );
            })
          }
        </section>
      </div>

      <div class="order-first lg:sticky lg:top-28 lg:order-none lg:self-start">
        <ProgressCard
          client:only="react"
          courseSlug={slug}
          code={data.code}
          totalDays={days.length}
        />
      </div>
    </div>
  </div>
</DefaultLayout>
