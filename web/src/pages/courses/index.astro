---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import Search from "astro-pagefind/components/Search.astro";
import { CourseCard } from "@/components/courses/CourseCard";
import { getCourseDays, getCourses, courseSlugFromId, weeksIn } from "@/lib/courses";

const courses = await getCourses();
const cards = [];
for (const c of courses) {
  const slug = courseSlugFromId(c.id);
  const days = await getCourseDays(slug);
  cards.push({
    slug,
    code: c.data.code,
    title: c.data.title,
    subtitle: c.data.subtitle,
    status: c.data.status,
    color: c.data.color,
    total: days.length,
    weeks: weeksIn(days),
    format: c.data.format ?? "days",
    labsHref: c.data.hasLabs ? `/courses/${slug}/labs/` : undefined,
    external: c.data.external,
  });
}
---

<DefaultLayout
  title="Courses"
  description="Reusable certification study courses — soft-contrast catalog."
>
  <div class="course-shell container pt-28 pb-20 lg:pt-40">
    <header class="mb-10 max-w-2xl">
      <p
        class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
      >
        Learning catalog
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        Courses
      </h1>
      <p class="text-muted-foreground mt-3 text-base leading-relaxed">
        Open a course for the weekday sessions, the official labs, and the companion course.
      </p>
      <div class="mt-5 max-w-lg" data-pagefind-ignore>
        <Search className="course-search" />
      </div>
    </header>

    <div class="grid gap-4 md:grid-cols-2">
      {
        cards.map((card) => (
          <CourseCard
            client:only="react"
            slug={card.slug}
            code={card.code}
            title={card.title}
            subtitle={card.subtitle}
            status={card.status}
            color={card.color}
            total={card.total}
            weeks={card.weeks}
            format={card.format}
            labsHref={card.labsHref}
            external={card.external}
          />
        ))
      }
    </div>
  </div>
</DefaultLayout>
